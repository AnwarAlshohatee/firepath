<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>FIREPath</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>FIREPath Calculator</h1>
    <p>Find out how much you need to achieve financial independence.</p>

    <form action="/calculate" method="POST">
        <label for="age">Current Age:</label>
        <input
            type="number"
            id="age"
            name="age"
            min="18"
            max="100"
            required
        >

        <label for="annualExpenses">Annual Retirement Expenses ($):</label>
        <input
            type="number"
            id="annualExpenses"
            name="annualExpenses"
            min="1"
            step="0.01"
            required
        >

        <label for="currentSavings">Current Savings ($):</label>
        <input
            type="number"
            id="currentSavings"
            name="currentSavings"
            min="0"
            step="0.01"
            required
        >

        <label for="annualContribution">Annual Contribution ($):</label>
        <input
            type="number"
            id="annualContribution"
            name="annualContribution"
            min="0"
            step="0.01"
            required
        >

        <label for="expectedReturn">Expected Annual Return (%):</label>
        <input
            type="number"
            id="annualReturn"
            name="annualReturn"
            value="7"
            min="0"
            max="20"
            step="0.1"
            required
        >

        <button type="submit">Calculate My FIRE Number</button>
    </form>
</body>
</html>